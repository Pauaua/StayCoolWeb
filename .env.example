# Connection string de Supabase — usa el "Transaction pooler" (puerto 6543),
# no la conexión directa, porque Vercel corre en funciones serverless y la
# conexión directa se queda sin slots disponibles rápido.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
